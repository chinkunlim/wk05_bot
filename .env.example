# ============================================================
# Google Apps Script / Telegram Bot 環境變數範本 (Script Properties)
# 請於 Google Apps Script「專案設定 ➔ 指令碼屬性」中填入以下鍵值
# ============================================================

# 1. Telegram Bot Token (向 @BotFather 註冊取得)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuvwx"

# 2. Google AI Studio Gemini API Key (向 Google AI Studio 免費申請)
GEMINI_API_KEY="AIzaSyD-YourGeminiApiKeyHere"

# 3. 授權訪問白名單 (逗點分隔之 Telegram User ID，可用 @userinfobot 查詢)
ALLOWED_USER_IDS="12345678,87654321"

# 4. Gemini 模型代號 (預設推薦官方永久穩定別名 gemini-flash-latest)
GEMINI_MODEL="gemini-flash-latest"

# 5. 每位使用者每日免費額度上限 (選填，預設為 75 次)
MAX_DAILY_REQUESTS=75

# 6. 配額計數基準時區 (選填，預設為 Asia/Taipei)
TIMEZONE="Asia/Taipei"
