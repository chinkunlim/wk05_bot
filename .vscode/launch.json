{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests/"],
      "console": "integratedTerminal"
    },
    {
      "name": "Node: Check GAS Syntax",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/check_gas.js",
      "console": "integratedTerminal"
    }
  ]
}
